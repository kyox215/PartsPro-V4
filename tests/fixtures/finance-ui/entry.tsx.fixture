import React from 'react';
import {createRoot} from 'react-dom/client';
import {AdminFinancePanel} from '@/components/partspro/admin-finance-panel';
import {I18nProvider} from '@/components/partspro/i18n-provider';
import {Menu, Search, Bell, Home, ClipboardList, Package, BarChart3, UsersRound, Settings, ChevronRight} from 'lucide-react';
const requestedLocale=new URLSearchParams(location.search).get('locale')||'zh';
const locale=requestedLocale==='zh'?'zh-CN':requestedLocale==='it'?'it-IT':'en-US';
const it=locale==='it-IT';
const readonly=new URLSearchParams(location.search).has('readonly');
function App(){return <I18nProvider locale={locale} scope="admin" dictionary={{}}><div className="min-h-screen bg-slate-50 text-slate-900"><aside className="fixed inset-y-0 left-0 hidden w-56 flex-col border-r border-slate-200 bg-white lg:flex"><div className="px-6 py-7 text-xl font-black tracking-tight">parts<span className="text-blue-600">pro</span><p className="mt-1 text-[10px] font-medium tracking-widest text-slate-400">BUSINESS WORKSPACE</p></div><div className="space-y-2 px-3">{[[Home,it?'Panoramica':'总览'],[ClipboardList,it?'Ordini':'订单'],[Package,it?'Catalogo':'商品目录'],[UsersRound,it?'Clienti':'客户'],[BarChart3,it?'Finanza':'财务管理'],[Settings,it?'Impostazioni':'设置']].map(([Icon,label],i)=><div key={i} className={`flex items-center gap-3 rounded-xl px-4 py-3 text-sm ${i===4?'bg-blue-50 font-semibold text-blue-700':'text-slate-500'}`}><Icon className="size-4"/>{label}</div>)}</div><div className="mt-auto border-t border-slate-100 p-5 text-xs text-slate-500">PartsPro · Italia<br/><span className="mt-1 block text-[10px]">{it?'Anteprima · dati dimostrativi':'页面预览 · 演示数据'}</span></div></aside><div className="lg:pl-56"><header className="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6"><div className="flex items-center gap-3 text-sm"><Menu className="size-5 text-slate-500 lg:hidden"/><span className="text-slate-400">{it?'Workspace':'工作台'}</span><ChevronRight className="size-3 text-slate-400"/><span className="font-semibold">{it?'Finanza':'财务'}</span></div><div className="flex items-center gap-4"><Search className="size-4 text-slate-500"/><Bell className="size-4 text-slate-500"/><div className="grid size-8 place-items-center rounded-full bg-blue-100 text-xs font-bold text-blue-700">PP</div></div></header><main className="mx-auto max-w-[1600px] p-3 sm:p-6"><div className="mb-3 text-right text-[10px] font-medium tracking-wide text-slate-400">{locale==='en-US'?'REAL COMPONENT PREVIEW · DEMO DATA':it?'ANTEPRIMA COMPONENTI REALI · DATI DIMOSTRATIVI':'真实组件预览 · 演示数据'}</div><AdminFinancePanel currentUserId="fixture-admin" permissions={readonly?['finance.read']:['finance.read','finance.manage','finance.export']}/></main></div></div></I18nProvider>}
createRoot(document.getElementById('root')!).render(<App/>);
