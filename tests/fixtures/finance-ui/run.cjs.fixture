const projectRequire=require('module').createRequire(process.cwd()+'/package.json');
const {chromium}=projectRequire(process.env.PLAYWRIGHT_MODULE||'playwright');
const fs=require('fs'),http=require('http'),assert=require('assert/strict'),path=require('path');
const {pathToFileURL}=require('url');
const dir=__HARNESS_DIR__,output=process.env.FINANCE_UI_OUTPUT_DIR;
fs.mkdirSync(output,{recursive:true});
const server=http.createServer((req,res)=>{
 if(req.url==='/bundle.js'){res.setHeader('Content-Type','application/javascript');res.end(fs.readFileSync(dir+'/bundle.js'));return;}
 if(req.url==='/style.css'){res.setHeader('Content-Type','text/css');res.end(fs.readFileSync(dir+'/style.css'));return;}
 res.setHeader('Content-Type','text/html');res.end('<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"></head><body><div id="root"></div><script>window.process={env:{NODE_ENV:"development"}}</script><script src="/bundle.js"></script></body></html>');
});
(async()=>{
 const core=await import(pathToFileURL(process.cwd()+'/src/lib/partspro-finance-core.mjs').href);
 const today=core.financeDay();
 const uuid='11111111-1111-4111-8111-111111111111';
 const baseRow={currency:'EUR',orderId:null,orderNo:null,skuCode:null,batchId:null,batchCode:null,supplierId:null,supplierName:null,category:null,status:null,confidence:null,metadata:{}};
 const rows=[];
 for(let i=0;i<60;i++){
  const day=core.shiftFinanceDay(today,-59+i),sale=core.financeRound(240+(i*47)%430),cost=core.financeRound(sale*(0.55+(i%4)*0.04));
  rows.push({...baseRow,id:'sale-'+i,type:'sale',date:day+'T12:00:00Z',title:'Sales net',amountNet:sale,category:'sales',status:'paid',orderId:uuid,orderNo:'PP-2026-'+(1200+i)});
  rows.push({...baseRow,id:'cogs-'+i,type:'cogs',date:day+'T12:00:00Z',title:'Cost of goods sold',amountNet:cost,category:'cogs',status:'consumed',confidence:i%7===0?'estimated':'exact',orderId:uuid,orderNo:'PP-2026-'+(1200+i),skuCode:'IP15-OLED',batchCode:'UT-2026-1018',batchId:uuid,supplierName:'UTOPYA'});
 }
 const expenseEntries=[{id:uuid,description:'仓储租金 / Affitto magazzino',category:'rent',amountNet:360,vatAmount:0,status:'paid',occurredAt:today,paidAt:today+'T10:00:00Z',currency:'EUR',paymentMethod:'bank_transfer',reference:'RENT-10',notes:'',counterpartyName:'Magazzino Roma'},{id:'22222222-2222-4222-8222-222222222222',description:'物流配送 / Spedizioni',category:'shipping',amountNet:126.5,vatAmount:27.83,status:'pending',occurredAt:today,currency:'EUR',paymentMethod:'',reference:'',notes:'',counterpartyName:'Corriere'}];
 for(const entry of expenseEntries)rows.push({...baseRow,id:'expense:'+entry.id,type:'expense',date:today,title:entry.description,amountNet:entry.amountNet,category:entry.category,status:entry.status,supplierName:entry.counterpartyName,metadata:{entry}});
 const paymentEntry={id:uuid,batchId:uuid,batchCode:'UT-2026-1018',amountNet:500,vatAmount:0,status:'paid',paidAt:core.shiftFinanceDay(today,-40)+'T12:00:00Z',createdAt:core.shiftFinanceDay(today,-40),supplierName:'UTOPYA',supplierId:uuid,currency:'EUR',note:'Acconto',reference:'TRX-100',paymentMethod:'bank_transfer'};
 rows.push({...baseRow,id:'supplier_payment:'+uuid,type:'supplier_payment',date:paymentEntry.createdAt,title:'Supplier payment',amountNet:500,batchId:uuid,batchCode:paymentEntry.batchCode,supplierName:'UTOPYA',status:'paid',metadata:{entry:paymentEntry}});
 for(let i=0;i<4;i++)rows.push({...baseRow,id:'receivable-'+i,type:'receivable',date:today,title:'Pending receivable',amountNet:120+i*63.2,orderId:uuid,orderNo:'PP-2026-'+(1300+i),status:'pending',category:'receivable'});
 const purchases=[{...baseRow,id:'purchase:1',type:'purchase',date:today,title:'Purchase batch',amountNet:2680,batchCode:'UT-2026-1018',batchId:uuid,supplierName:'UTOPYA',confidence:'exact',paidNet:500,outstandingNet:2180},{...baseRow,id:'purchase:2',type:'purchase',date:today,title:'Purchase batch',amountNet:1845.8,batchCode:'MBX-2026-1014',batchId:'22222222-2222-4222-8222-222222222222',supplierName:'Mobilax',confidence:'estimated',paidNet:1200,outstandingNet:645.8}];
 rows.push(...purchases);
 const checks=[],requests=[],writes=[];let failSave=false,failAnalysis=false;
 const errors=[];let browser;
 await new Promise((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve)});
 const origin='http://127.0.0.1:'+server.address().port;
 try{
  browser=await chromium.launch({headless:true,channel:'chrome'});
  const page=await browser.newPage({viewport:{width:1440,height:1000},timezoneId:'America/New_York',reducedMotion:'reduce'});
  page.setDefaultTimeout(15000);page.on('pageerror',e=>errors.push(e.message));
  await page.route('**/api/admin/finance/**',async route=>{
   const req=route.request(),url=new URL(req.url()),p=url.searchParams,endpoint=url.pathname.split('/').at(-1);requests.push(url.pathname+'?'+url.searchParams);
   if(req.method()!=='GET'){
    const body=req.postDataJSON();if(req.method()==='PATCH'){assert.equal(body.expectedUpdatedAt,'2026-10-18T10:00:00.123456+00:00');assert.ok(body.correctionReason);}
    writes.push({url:url.pathname,method:req.method(),body});
    await new Promise(r=>setTimeout(r,100));
    await route.fulfill({status:failSave?500:200,json:failSave?{error:{message:'模拟保存失败 / Errore simulato'}}:{data:{id:uuid,...body}}});return;
   }
   const from=p.get('dateFrom'),to=p.get('dateTo');
   const filtered=rows.filter(row=>(!from||core.financeDay(row.date)>=from)&&(!to||core.financeDay(row.date)<=to)&&(!p.get('type')||row.type===p.get('type'))&&(!p.get('q')||[row.title,row.batchCode,row.skuCode,row.orderNo].join(' ').toLowerCase().includes(p.get('q').toLowerCase())));
   const offset=Number(p.get('offset')||0),limit=Number(p.get('limit')||25);
   if(url.pathname.includes('/entries/')){const isExpense=url.pathname.includes('/expense/');const entry=isExpense?expenseEntries.find(e=>e.id===endpoint):paymentEntry;await route.fulfill({json:{data:{...entry,amountGross:entry.amountNet+entry.vatAmount,version:'2026-10-18T10:00:00.123456+00:00'}}});return;}
   if(endpoint==='batch-options'||endpoint==='supplier-batch-options'){
    assert.equal(from,null);assert.equal(to,null);
    const all=Array.from({length:31},(_,i)=>({id:i?`${String(i+1).padStart(8,'0')}-1111-4111-8111-111111111111`:uuid,batchCode:i?'MBX-2026-'+i:'UT-2026-1018',supplierName:i?'Mobilax':'UTOPYA',currency:'EUR',paidNet:500,outstandingNet:2180,latestPaidAt:null,costBasis:'confirmed_net'})).filter(row=>!p.get('q')||`${row.batchCode} ${row.supplierName}`.toLowerCase().includes(p.get('q').toLowerCase()));
    await route.fulfill({json:{data:all.slice(offset,offset+limit),meta:{total:all.length,offset,limit,returned:all.slice(offset,offset+limit).length}}});return;
   }
   if(endpoint==='analysis'){
    if(failAnalysis){await route.fulfill({status:503,json:{error:{message:'模拟统计读取失败'}}});return;}
    const days=Math.round((Date.parse(to)-Date.parse(from))/86400000)+1,prevTo=core.shiftFinanceDay(from,-1),prevFrom=core.shiftFinanceDay(from,-days);
    const prev=rows.filter(row=>core.financeDay(row.date)>=prevFrom&&core.financeDay(row.date)<=prevTo);
    const analysis=core.buildFinanceAnalysis(filtered,prev,from,to),sum=key=>core.financeRound(analysis.trend.reduce((n,row)=>n+row[key],0));
    const summary={salesNet:sum('salesNet'),cogsNet:sum('cogsNet'),expenseNet:sum('expenseNet'),grossProfit:sum('grossProfit'),operatingProfit:sum('operatingProfit'),grossMarginRate:core.financeRound(sum('grossProfit')/sum('salesNet')*100),pendingReceivables:core.financeRound(filtered.filter(r=>r.type==='receivable').reduce((n,r)=>n+r.amountNet,0)),accountsPayable:2825.8,purchaseNet:4525.8,inventoryCostValue:16869.32,confidence:{exact:26,estimated:4,unmatched:0},vatAmbiguousPurchaseNet:1845.8,currency:'EUR'};
    await route.fulfill({json:{data:{...analysis,summary,previousRange:{dateFrom:prevFrom,dateTo:prevTo},payables:purchases.slice(offset,offset+limit),payablesTotal:2}}});return;
   }
   if(endpoint==='cogs'){
    const allocations=filtered.filter(r=>r.type==='cogs').map(row=>({...row,quantity:3,unitCostNet:core.financeRound(row.amountNet/3),totalCostNet:row.amountNet,productName:'OLED iPhone 15',createdAt:row.date}));
    await route.fulfill({json:{data:allocations.slice(offset,offset+limit),meta:{total:allocations.length}}});return;
   }
   await route.fulfill({json:{data:filtered.slice(offset,offset+limit),meta:{total:filtered.length}}});
  });
  async function open(locale='zh',readonly=false){await page.goto(origin+'/admin?locale='+locale+(readonly?'&readonly':''),{waitUntil:'networkidle'});await page.getByRole('tab',{name:locale==='it'?'Panoramica':locale==='en'?'Overview':'经营总览',exact:true}).waitFor();await page.waitForTimeout(250);}
  for(const locale of ['zh','it','en']){
   for(const width of [320,390,768,1440]){
    await page.setViewportSize({width,height:width<768?844:1000});await open(locale);
    const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1);assert.equal(overflow,false,`${locale}/${width} document overflow`);
    const boxes=await page.locator('.recharts-responsive-container').evaluateAll(nodes=>nodes.map(n=>({w:n.getBoundingClientRect().width,h:n.getBoundingClientRect().height})));assert.ok(boxes.every(b=>b.w>0&&b.h>0));
    if(locale==='en'){const txt=await page.locator('main').innerText();assert.ok(!/[\u4e00-\u9fff]/.test(txt),'English finance contains Chinese UI');}
    if(width===390||width===1440)await page.screenshot({animations:'disabled',path:path.join(output,`finance-overview-${width}-${locale}.png`),fullPage:true});
    checks.push(`${locale}/${width}: overview charts, no document overflow`);
   }
  }
  await page.setViewportSize({width:390,height:844});await open();
  await page.getByRole('tab',{name:'客户应收',exact:true}).click();await page.getByRole('link',{name:'查看订单'}).first().waitFor();assert.ok((await page.getByRole('link',{name:'查看订单'}).first().getAttribute('href')).includes('orderId='));await page.screenshot({animations:'disabled',path:path.join(output,'finance-receivables-390-zh.png'),fullPage:true});checks.push('receivables link to existing order');
  await page.getByRole('tab',{name:'供应商应付',exact:true}).click();await page.getByRole('button',{name:'UT-2026-1018',exact:true}).waitFor();await page.waitForTimeout(200);assert.equal(await page.getByRole('tab',{name:'供应商应付',exact:true}).getAttribute('aria-selected'),'true');await page.screenshot({animations:'disabled',path:path.join(output,'finance-payables-390-zh.png'),fullPage:true});await page.getByRole('button',{name:'UT-2026-1018',exact:true}).click();await page.getByText('全历史付款 · 不限当前日期筛选',{exact:false}).waitFor();await page.getByRole('button',{name:'修改',exact:true}).waitFor();const historic=requests.findLast(r=>r.startsWith('/api/admin/finance/ledger')&&r.includes('q=UT-2026-1018'));assert.ok(!historic.includes('dateFrom'));await page.screenshot({animations:'disabled',path:path.join(output,'finance-payment-history-390-zh.png'),fullPage:true});checks.push('payables drilldown includes historical payments outside current range');
  await page.getByRole('tab',{name:'销售与成本',exact:true}).click();await page.getByRole('button',{name:'下一页',exact:true}).click();await page.waitForTimeout(200);assert.ok(requests.some(r=>r.includes('ledger?')&&r.includes('offset=25')));await page.getByRole('button',{name:'成本追溯',exact:true}).click();await page.getByText('OLED iPhone 15').first().waitFor();checks.push('ledger and COGS pagination');
  await page.getByRole('button',{name:'新增费用',exact:true}).click();const dialog=page.getByRole('dialog');await dialog.getByLabel('说明',{exact:true}).fill('测试租金');await dialog.getByLabel('净额',{exact:true}).fill('12,34');
  failSave=true;await dialog.getByRole('button',{name:'保存',exact:true}).click();await dialog.getByText('模拟保存失败 / Errore simulato',{exact:true}).waitFor();assert.equal(writes.at(-1).body.amountNet,12.34);assert.equal(await dialog.getByLabel('说明',{exact:true}).inputValue(),'测试租金');await page.screenshot({animations:'disabled',path:path.join(output,'finance-expense-form-390-zh.png'),fullPage:false});
  const before=writes.length;await dialog.getByLabel('净额',{exact:true}).fill('1,234');await dialog.getByRole('button',{name:'保存',exact:true}).click();assert.equal(writes.length,before);checks.push('comma decimals accepted; ambiguous money rejected without request; failed save preserves input');
  failSave=false;await dialog.getByLabel('净额',{exact:true}).fill('12,34');failAnalysis=true;await dialog.getByRole('button',{name:'保存',exact:true}).click();await page.getByRole('dialog').waitFor({state:'hidden'});await page.getByRole('status').filter({hasText:'已保存'}).waitFor();await page.getByRole('alert').filter({hasText:'模拟统计读取失败'}).waitFor();checks.push('successful save followed by refresh failure does not report save failure');failAnalysis=false;await page.getByRole('button',{name:'重试读取',exact:true}).first().click();await page.waitForTimeout(200);
  await page.getByRole('button',{name:'登记付款',exact:true}).click();const payDialog=page.getByRole('dialog');await payDialog.getByLabel('供应商',{exact:true}).fill('UTOPYA');await page.waitForTimeout(400);await payDialog.getByLabel('批次',{exact:true}).click();await page.getByRole('option').filter({hasText:'UT-2026-1018'}).click();await payDialog.getByLabel('净额',{exact:true}).fill('18,50');await page.screenshot({animations:'disabled',path:path.join(output,'finance-supplier-payment-390-zh.png'),fullPage:false});await payDialog.getByRole('button',{name:'保存',exact:true}).click();await page.getByRole('dialog').waitFor({state:'hidden'});assert.equal(writes.at(-1).body.batchId,uuid);assert.equal(writes.at(-1).body.amountNet,18.5);checks.push('finance-only RPC selector ignores current dates; payment uses selected batch');
  await page.getByRole('tab',{name:'费用账本',exact:true}).click();await page.getByRole('button',{name:'修改',exact:true}).first().click();await page.getByRole('dialog').getByLabel('净额',{exact:true}).fill('350,50');await page.getByRole('dialog').getByLabel('更正原因',{exact:true}).fill('Invoice reconciliation');await page.getByRole('dialog').getByRole('button',{name:'保存',exact:true}).click();await page.getByRole('dialog').waitFor({state:'hidden'});assert.equal(writes.at(-1).method,'PATCH');assert.equal(writes.at(-1).body.amountNet,350.5);assert.equal(writes.at(-1).body.expectedUpdatedAt,'2026-10-18T10:00:00.123456+00:00');assert.equal(writes.at(-1).body.correctionReason,'Invoice reconciliation');checks.push('expense edit uses PATCH with retained record fields');
  await page.getByLabel('开始日期',{exact:true}).fill('2026-10-20');await page.getByLabel('结束日期',{exact:true}).fill('2026-10-01');await page.getByRole('button',{name:'应用筛选',exact:true}).click();await page.getByRole('alert').filter({hasText:'请选择有效日期'}).waitFor();checks.push('reversed date range blocked');
  await open('it',true);assert.equal(await page.getByRole('button',{name:'Nuova spesa',exact:true}).count(),0);assert.equal(await page.getByRole('button',{name:'Registra pagamento',exact:true}).count(),0);await page.getByRole('tab',{name:'Esporta / verifica',exact:true}).click();assert.equal(await page.getByRole('link',{name:'CSV',exact:true}).count(),0);checks.push('read-only user has no mutation or export actions');
  assert.deepEqual(errors,[],'browser runtime errors');
  fs.writeFileSync(path.join(output,'verification.json'),JSON.stringify({mode:'isolated real components / mocked API, synthetic data; no production writes',checks,requests,writes: writes.map(w=>({method:w.method,url:w.url,amountNet:w.body.amountNet})),errors},null,2));
  console.log(JSON.stringify({passed:checks.length,output,errors},null,2));
 }finally{await browser?.close();server.close();}
})().catch(error=>{console.error(error);process.exitCode=1;server.close();});
