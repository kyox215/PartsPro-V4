require = require('module').createRequire(process.cwd()+'/package.json');
const fs=require('fs'),path=require('path');
const project=process.cwd(),src=project,dir=__dirname;
const ts=require(project+'/node_modules/typescript');
const workerRegistration=JSON.stringify('void navigator.serviceWorker.register("/sw.js", {\n        scope: "/",\n        updateViaCache: "none",\n      });');
const loaderPatch=JSON.stringify('const [profileSummaryOpen, setProfileSummaryOpen] = React.useState(new URLSearchParams(location.search).get("view")==="profile")');
fs.writeFileSync(dir+'/loader.cjs',`const ts=require(${JSON.stringify(require.resolve('typescript'))});module.exports=function(source){if(this.resourcePath.endsWith('/account-page.tsx')){source=source.replace('const [profileSummaryOpen, setProfileSummaryOpen] = React.useState(false)',${loaderPatch});source+=';export {AccountProfileDialog};';}if(this.resourcePath.endsWith('/notification-center.tsx'))source=source.replace(${workerRegistration},'void 0;').replaceAll('推送密钥未配置','浏览器推送暂不可用');return ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext,jsx:ts.JsxEmit.ReactJSX}}).outputText}`);
fs.writeFileSync(dir+'/navigation.ts',`import React from 'react';let revision=0;const listeners=new Set();function update(url){const u=new URL(url,location.href);const q=new URLSearchParams(location.search);for(const k of ['section','orderId','page','q'])q.delete(k);for(const [k,v]of u.searchParams)q.set(k,v);if(u.pathname==='/rma')q.set('view','rma');else if(u.pathname==='/account')q.delete('view');else {window.dispatchEvent(new CustomEvent('demo-note',{detail:'设计预览：此入口沿用当前网站功能。'}));return;}history.replaceState({},'',location.pathname+'?'+q);revision++;listeners.forEach(f=>f());}const router={replace:update,push:update,refresh(){revision++;listeners.forEach(f=>f());}};export function useRouter(){return router}export function useSearchParams(){const v=React.useSyncExternalStore(f=>{listeners.add(f);return()=>listeners.delete(f)},()=>location.search+revision);return React.useMemo(()=>new URLSearchParams(location.search),[v])}export const usePathname=()=>new URLSearchParams(location.search).get('view')==='rma'?'/rma':'/account';`);
fs.writeFileSync(dir+'/link.tsx',`import React from 'react';export const useLinkStatus=()=>({pending:false});import {useRouter} from './navigation';export default function Link({href,children,onClick,...props}){const router=useRouter();return <a href={href} {...props} onClick={e=>{onClick?.(e);if(!e.defaultPrevented){e.preventDefault();router.push(href)}}}>{children}</a>}`);
fs.writeFileSync(dir+'/image.tsx',`import React from 'react';export default function Image({src,alt,className,style,width,height}){return <img className={className} style={style} width={width} height={height} src={typeof src==='string'?src:src.src} alt={alt}/>}`);
fs.writeFileSync(dir+'/pricing.ts',`export const usePricingSession=()=>({ready:true,key:'offline-preview',authenticated:true});`);
fs.writeFileSync(dir+'/actions.ts',`export async function signOut(){window.dispatchEvent(new CustomEvent('demo-note',{detail:'设计预览：不会退出真实账户。'}))}`);
fs.writeFileSync(dir+'/loading.tsx',`import React from 'react';export const StorefrontLoading=()=> <p role="status">预览载入中</p>;`);
const alias={'./storefront-loading':dir+'/loading.tsx','next/navigation':dir+'/navigation.ts','next/link':dir+'/link.tsx','next/image':dir+'/image.tsx','./optimized-image':dir+'/image.tsx','./use-pricing-session':dir+'/pricing.ts','./support-chat-panel':dir+'/support-preview.tsx','@/app/actions/i18n':dir+'/locale-actions.ts','@/lib/supabase/client':dir+'/supabase-client.ts','@/lib/supabase/env':dir+'/supabase-env.ts','@/app/login/actions':dir+'/actions.ts','@':src+'/src'};
const webpack=require('next/dist/compiled/webpack/webpack').webpack;
webpack({mode:'development',devtool:false,entry:dir+'/entry.tsx',output:{path:dir,filename:'bundle.js'},resolve:{extensions:['.tsx','.ts','.mjs','.js'],alias,modules:[project+'/node_modules']},module:{rules:[{test:/\.tsx?$/,exclude:/node_modules/,use:dir+'/loader.cjs'}]},plugins:[new webpack.DefinePlugin({'process.env.NODE_ENV':JSON.stringify('development'),'process.env.NEXT_PUBLIC_SUPABASE_URL':JSON.stringify(''),'process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY':JSON.stringify('')})]},(error,stats)=>{if(error||stats.hasErrors()){console.error(error||stats.toString({all:false,errors:true,moduleTrace:true,errorDetails:true}));process.exitCode=1}else console.log('Actual production account/RMA components compiled for offline preview')});
const styles=['globals.css','storefront-ui.css','catalog-ui.css','account-ui.css','commerce-ui.css','reference-ui.css','mobile-ui.css','account-mobile-density.css'];
(async()=>{const postcss=require('postcss'),tailwind=require('@tailwindcss/postcss');const css=(await postcss([tailwind()]).process(fs.readFileSync(src+'/src/app/globals.css','utf8'),{from:src+'/src/app/globals.css'})).css;fs.writeFileSync(dir+'/current.css',css+'\n'+styles.slice(1).map(s=>fs.readFileSync(src+'/src/app/'+s,'utf8')).join('\n'));})();
