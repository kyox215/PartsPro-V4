import React from 'react';import {X,Headphones} from 'lucide-react';export function SupportChatPanel({onClose}){return <section role="dialog" aria-label="客服预览" className="rounded-lg border bg-white p-4 shadow-xl" style={{width:'min(360px,calc(100vw - 24px))'}}><header className="flex items-center justify-between gap-4"><strong>PartsPro 客服</strong><button onClick={onClose} aria-label="关闭客服"><X/></button></header><div className="flex items-center gap-3 py-8 text-sm text-slate-500"><Headphones/>设计预览：客服入口保留，不会发送消息。</div></section>}