import {getDictionary} from '@/i18n/get-dictionary';
import {useSearchParams} from './navigation';
import {ProfessionalApplicationPage} from '@/components/partspro/professional-application-page';
import {SupportWidget} from '@/components/partspro/support-widget';
const init=new URLSearchParams(location.search);
const variant='actual';
document.documentElement.dataset.variant=variant;
const profile={id:'demo-customer',companyName:'Officina Mobile Roma',contactName:'demo_whatsapp',email:'demo@example.com',phone:'+39 000 000 0000',fiscalCode:'00000000000',vatNumber:'00000000000',sdi:'0000000',pec:'demo@pec.example.com',shippingAddress:'Via Esempio 18, 00100 Roma (RM)',billingAddress:'Via Esempio 18, 00100 Roma (RM)',status:'active',level:'silver',baseLevel:'bronze',customerType:'wholesale',assignmentStatus:'assigned',profileCompletedAt:'2026-10-18T12:00:00Z'};
const company={id:'demo-customer',name:profile.companyName,contactName:profile.contactName,email:profile.email,phone:profile.phone,partitaIva:'00000000000',codiceFiscale:'00000000000',codiceDestinatario:'0000000',pec:profile.pec,shippingAddress:profile.shippingAddress,billingAddress:profile.billingAddress,city:'Roma',province:'RM',status:'approved',customerType:'wholesale',priceList:'silver',assignmentStatus:'assigned',profileKind:'customer'};
const orders=[{id:'PP-DEMO-0821',date:'18/10/2026 15:48',items:5,company:profile.companyName,total:138,status:'shipped'},{id:'PP-DEMO-0820',date:'18/10/2026 11:20',items:3,company:profile.companyName,total:82.5,status:'pending_payment'},{id:'PP-DEMO-0817',date:'17/10/2026 16:05',items:8,company:profile.companyName,total:268,status:'picking'},{id:'PP-DEMO-0814',date:'14/10/2026 09:32',items:2,company:profile.companyName,total:64,status:'completed'}];
const requests=[{id:'demo-rma-42',rmaNo:'RMA-DEMO-0042',status:'approved',productName:'iPhone 13 OLED 屏幕总成',sku:'DEMO-1301',orderId:orders[0].id,orderNumber:orders[0].id,createdAt:'18/10/2026 16:00',quantity:1},{id:'demo-rma-43',rmaNo:'RMA-DEMO-0043',status:'requested',productName:'iPhone 12 标准容量电池',sku:'DEMO-1201',orderId:orders[3].id,orderNumber:orders[3].id,createdAt:'18/10/2026 17:00',quantity:2}];
const wallet={balance:128.5,currency:'EUR',transactions:[{id:'tx1',orderId:orders[0].id,reason:'订单缺货退款',direction:'credit',amount:76.5,createdAt:'2026-10-18T17:20:00Z'},{id:'tx2',orderId:orders[0].id,reason:'钱包余额自动抵扣订单',direction:'debit',amount:20,createdAt:'2026-10-18T15:32:00Z'},{id:'tx3',orderId:orders[2].id,reason:'钱包余额自动抵扣订单',direction:'debit',amount:108,createdAt:'2026-10-17T16:05:00Z'},{id:'tx4',orderId:orders[3].id,reason:'售后退款入账',direction:'credit',amount:80,createdAt:'2026-10-16T10:21:00Z'},{id:'tx5',orderId:orders[3].id,reason:'售后退款入账',direction:'credit',amount:100,createdAt:'2026-10-15T14:08:00Z'}]};
const detail={id:orders[0].id,number:orders[0].id,createdAt:'2026-10-18T15:48:00Z',status:'shipped',paymentStatus:'paid',total:138,items:5,walletAppliedAmount:20,carrier:'GLS',service:'标准配送',tracking:'DEMO001234567',shippingAddress:profile.shippingAddress,lines:[{id:'line-1',sku:'DEMO-1301',productName:'iPhone 13 OLED 屏幕总成 · 黑色',quantity:2,unitPrice:45,lineTotal:90,imageUrl:'assets/display.png'},{id:'line-2',sku:'DEMO-1201',productName:'iPhone 12 标准容量电池',quantity:3,unitPrice:16,lineTotal:48}],operationHistory:[{id:'e1',eventType:'order_shipped',createdAt:'2026-10-18T15:48:00Z',note:'包裹已交给承运商（演示）'},{id:'e2',eventType:'payment_confirmed',createdAt:'2026-10-18T15:32:00Z',note:'付款已确认（演示）'}]};
const rmaDto={...requests[0],createdAt:'2026-10-18T16:00:00Z',attachments:[],customerShippedAt:null,customerStage:'awaiting_return',description:'安装测试时显示异常（演示）',eligibleUntil:null,events:[{id:'e1',createdAt:'2026-10-18T17:45:00Z',eventType:'approved',toStatus:'approved',note:'请按客服确认的要求寄回商品（演示）'}],policyScope:'b2b_commercial',reason:'quality_defect',reasonCode:'quality_defect',resolution:'wallet_credit',requestedResolution:'wallet_credit',updatedAt:'2026-10-18T17:45:00Z',canMarkShipped:true};
const options=[{...orders[0],number:orders[0].id,lines:[{id:'00000000-0000-4000-8000-000000000001',sku:'DEMO-1301',productName:'iPhone 13 OLED 屏幕总成',imageUrl:'assets/display.png',orderedQuantity:2,alreadyRequestedQuantity:0,remainingQuantity:2,unitPrice:45,lineTotal:90},{id:'00000000-0000-4000-8000-000000000002',sku:'DEMO-1201',productName:'iPhone 12 标准容量电池',orderedQuantity:3,alreadyRequestedQuantity:0,remainingQuantity:3,unitPrice:16,lineTotal:48}]}];
const notices=[['10000000-0000-4000-8000-000000000001','订单已发货','订单 PP-DEMO-0821 已交给承运商。','/account?section=orders&orderId=PP-DEMO-0821','order_shipped'],['10000000-0000-4000-8000-000000000002','售后申请待寄回','申请 RMA-DEMO-0042 已受理，请查看寄回要求。','/rma?requestId=demo-rma-42','rma_updated'],['10000000-0000-4000-8000-000000000003','退款已进入钱包','缺货退款 76,50 € 已入账。','/account?section=wallet','wallet_credit']].map(([id,title,body,targetPath,eventType])=>({id,title,body,targetPath,eventType,audience:'customer',createdAt:'2026-10-18T17:45:00Z',readAt:null,payload:{},sourceAction:null}));
let savedProfile=profile,read=false;
if(init.has('long')) {profile.companyName='OfficinaRiparazioniDispositiviProfessionaliRoma'.repeat(3);profile.email='account-'+ 'x'.repeat(70)+'@example.com';profile.contactName='WhatsAppClienteInternazionale'.repeat(4);orders[0].id='PP-'+ '1234567890'.repeat(6);requests[0].productName='RicambioProfessionaleCompatibile'.repeat(6);wallet.transactions[0].reason='Rimborso per articolo difettoso e restituzione al magazzino '.repeat(4);}
const nativeFetch=window.fetch.bind(window);
window.fetch=async(input,config={})=>{const u=new URL(typeof input==='string'?input:input.url,location.href);if(u.origin!==location.origin)throw new Error('Offline preview blocks external requests');if(!u.pathname.startsWith('/api/'))return nativeFetch(input,config);let payload:any={data:[]},status=200;
 if(u.pathname==='/api/catalog-directory')payload={data:{nodes:[],revision:'offline-preview'}};
 else if(u.pathname==='/api/me')payload={authenticated:true,accountType:'customer',displayName:'Cliente Demo',email:profile.email};
 else if(u.pathname.includes('/notifications/summary'))payload={data:{latestCreatedAt:'2026-10-18T17:45:00Z',unreadCount:read?0:3}};
 else if(u.pathname.endsWith('/notifications/read')){read=true;payload={data:{ok:true,updated:3}};}
 else if(u.pathname.endsWith('/notifications/config'))payload={data:{enabled:false,publicKey:null}};
 else if(u.pathname==='/api/notifications')payload={data:{notifications:notices.map(n=>({...n,readAt:read?'2026-10-18T18:00:00Z':null})),unreadCount:read?0:3,hasMore:false,nextCursor:null}};
 else if(u.pathname.startsWith('/api/account/orders/')){const id=decodeURIComponent(u.pathname.split('/').pop()),o=orders.find(o=>o.id===id)||orders[0];payload={data:id===orders[0].id?detail:{...detail,id,number:id,createdAt:o.id==='PP-DEMO-0820'?'2026-10-18T09:20:00Z':'2026-10-17T14:05:00Z',status:o.status,paymentStatus:o.status==='pending_payment'?'pending':'paid',total:o.total,items:o.items,walletAppliedAmount:0,tracking:'',carrier:'',service:'',lines:[{id:'demo-line-'+id,sku:'DEMO-ITEM',productName:'所购配件（演示）',quantity:o.items,unitPrice:o.total/o.items,lineTotal:o.total}],operationHistory:[{id:'demo-order-created',eventType:'order_created',createdAt:'2026-10-18T11:20:00Z',note:'订单已创建（演示）'}]}};}
 else if(u.pathname==='/api/account/profile'){if(config.method==='POST'||config.method==='PATCH'){const next=JSON.parse(String(config.body||'{}'));savedProfile={...savedProfile,...next};}payload={data:savedProfile};}
 else if(u.pathname==='/api/italy-cap')payload={data:{postalCode:'00100',city:'Roma',province:'RM',matches:[]}};
 else if(u.pathname==='/api/rma')payload=init.get('state')==='error'?{error:{message:'Fixture unavailable'}}:{data:init.get('state')==='empty'?[]:[rmaDto],meta:{orderOptions:init.get('state')==='empty'?[]:options,warnings:[]}};
 else {status=400;payload={error:{message:'设计预览不执行真实业务操作。',code:'PREVIEW_ONLY'}};}
 return new Response(JSON.stringify(payload),{status,headers:{'Content-Type':'application/json'}});
};
function Demo(){const q=useSearchParams(),section=q.get('section')||'overview',view=q.get('view')||'',empty=q.get('state')==='empty';const[dialog,setDialog]=React.useState(view==='edit'||view==='address');const[msg,setMsg]=React.useState('');React.useEffect(()=>{const f=(e:any)=>{setMsg(e.detail);setTimeout(()=>setMsg(''),3000)};window.addEventListener('demo-note',f);return()=>window.removeEventListener('demo-note',f)},[]);
 React.useEffect(()=>{if(view==='address'){setTimeout(()=>{[...document.querySelectorAll('[role="dialog"] button')].find((b:any)=>b.textContent==='配送与账单')?.click()},100)}},[view]);
 React.useEffect(()=>{if(view==='notifications')setTimeout(()=>{document.querySelector<HTMLButtonElement>('.pp-account-notification-button')?.click()},150)},[view]);
 return <I18nProvider locale={(q.get('locale')||'zh-CN') as any} scope="storefront" dictionary={getDictionary((q.get('locale')||'zh-CN') as any)}>{view==='professional'?<ProfessionalApplicationPage/>:view==='rma'?<RmaPage initialAccountAccess={{userId:'demo',authenticated:true,accountType:'customer',canViewPrices:true,canCheckout:true,status:'ready',canOpenAdmin:false,displayName:'Cliente Demo',email:profile.email,role:null}} initialOrderId={orders[0].id} initialRequestId={q.get('requestId')||undefined}/>:<AccountPage key={section+view+empty} loadedSection={section as any} initialAccountAccess={{userId:'demo',authenticated:true,accountType:'customer',canViewPrices:true,canCheckout:true,status:'ready',canOpenAdmin:false,displayName:'Cliente Demo',email:profile.email,role:null}} customerProfile={savedProfile} company={company} userEmail={profile.email} orderSummaries={empty?[]:orders.filter(o=>!q.get('q')||o.id.toLowerCase().includes(q.get('q')!.toLowerCase()))} rmaRequests={empty?[]:requests} wallet={empty?{balance:0,currency:'EUR',transactions:[]}:wallet} dataWarning={q.get('state')==='error'?'订单读取失败':undefined}/>}{dialog&&<AccountProfileDialog open={dialog} onOpenChange={setDialog} onSaved={p=>{savedProfile=p;setMsg('演示资料已保存，仅预览内有效');setDialog(false)}} profile={savedProfile} userEmail={profile.email}/>}<SupportWidget/>{msg&&<div className="preview-toast" role="status">{msg}</div>}</I18nProvider>;
}
createRoot(document.getElementById('root')!).render(<Demo/>);
