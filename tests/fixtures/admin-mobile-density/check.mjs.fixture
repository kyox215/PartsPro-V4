import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {createRequire} from 'node:module';
const require=createRequire(import.meta.url);const {chromium}=require(process.env.PLAYWRIGHT_MODULE || 'playwright');
const out='outputs/mobile-density/2026-10-11';await fs.mkdir(out,{recursive:true});
const browser=await chromium.launch({channel:'chrome',headless:true});
const results=[];
const productBase={name:'REMAX 数据线 / Cavo USB professionale',brand:'REMAX',category:'Connettori',catalogDepartment:'general_merchandise',grade:'A',price:10,retailPrice:15,costPrice:5,stock:8,availableQty:7,status:'In Stock',stockStatus:'In Stock',catalogStatus:'active',updatedAt:'2026-10-10T08:00:00.123456Z',moq:1,warehouse:'Milano',compatibleWith:[],tags:[],imageUrl:'/pwa/icon-192.png',catalogUrl:'/catalogo',storefrontVisible:true,storefrontUrl:'/prodotto/UX-1',supplier:'Fixture',modelCodes:[]};
for(const [width,height,locale] of [[320,700,'zh-CN'],[360,740,'it'],[390,700,'zh-CN'],[430,760,'it'],[768,900,'it'],[1280,900,'zh-CN']].filter(item=>!process.env.MOBILE_TEST_WIDTH||item[0]===Number(process.env.MOBILE_TEST_WIDTH))){
 const context=await browser.newContext({viewport:{width,height}});const page=await context.newPage();page.setDefaultTimeout(8000);let products=Array.from({length:12},(_,i)=>({...productBase,sku:'UX-'+(i+1),name:i===11?'测试超长名称无空格abcdefghijklmnopqrstuvwxyz0123456789'.repeat(3):productBase.name+' '+(i+1)}));
 let nodes=[...Array.from({length:10},(_,i)=>({id:`00000000-0000-4000-8000-${String(i+1).padStart(12,'0')}`,kind:'brand',countsByDepartment:{general_merchandise:i+1},value:'BRAND-'+i,nameZh:'品牌 '+i,nameIt:'Marca '+i,active:true,position:i*10,version:1,count:i+1})),{id:'00000000-0000-4000-8000-000000000100',countsByDepartment:{general_merchandise:12},kind:'department',value:'general_merchandise',nameZh:'电子产品 · 高端产品',nameIt:'Elettronica e prodotti premium',active:true,position:0,version:1,count:12}];let posts=[];let productWrites=[];let rejectSave=false;let unknownSave=false;const errors=[];page.on('pageerror',e=>errors.push(e.message));
 await context.route('**/api/**',async route=>{const req=route.request(),url=new URL(req.url());let data=[],meta={source:'supabase',total:12,returned:12};
 if(url.pathname==='/api/catalog-directory'||url.pathname==='/api/admin/catalog-directory'){
  if(req.method()==='POST'){const input=req.postDataJSON();posts.push(input);if(rejectSave){rejectSave=false;await route.fulfill({status:409,contentType:'application/json',body:JSON.stringify({error:{message:'Fixture conflict'}})});return;}nodes=nodes.map(node=>node.id===input.id?{...node,...input,version:node.version+1}:node);if(unknownSave){unknownSave=false;await route.fulfill({status:503,json:{error:{message:'Synthetic unknown after commit'}}});return;}}
  data={nodes,revision:'1'};
 }else if(url.pathname==='/api/admin/products'){if(req.method()==='PATCH'){const body=req.postDataJSON();productWrites.push(body);products=products.map(item=>item.sku===body.sku?{...item,...body.product,updatedAt:'2026-10-11T02:00:00Z'}:item);data=products.find(item=>item.sku===body.sku);}else data=products;meta={source:'supabase',total:12,returned:12,summary:{total:12,active:12}};}
 else if(url.pathname==='/api/admin/products/model-groups')data=[{brand:'REMAX',models:[],series:[]}];
 else if(url.pathname==='/api/me'){await route.fulfill({json:{permissions:[],userId:'00000000-0000-4000-8000-000000000001'}});return;}
 else if(url.pathname.includes('notifications'))data={notifications:[],unreadCount:105};
 await route.fulfill({status:200,contentType:'application/json',body:JSON.stringify({data,meta})});
 });
 try{
  await page.goto(`http://127.0.0.1:3178/admin?panel=catalog&locale=${locale}`,{waitUntil:'domcontentloaded'});
  await page.locator(width<1024?'[data-product-sku]':'tbody tr').first().waitFor();await page.waitForTimeout(250);
  const metrics=await page.evaluate(()=>({overflow:document.documentElement.scrollWidth>innerWidth+1,rows:[...document.querySelectorAll('[data-product-sku]')].map(el=>{let r=el.getBoundingClientRect();return{top:r.top,bottom:r.bottom,height:r.height}})}));
  assert.equal(metrics.overflow,false);if(width===390)assert.ok(metrics.rows.filter(r=>r.height>0&&r.top>=0&&r.bottom<=height).length>=5,'5 complete mobile products');
  await page.screenshot({animations:"disabled",path:`${out}/products-${width}-${locale}.png`});
  if(width===390){
   await page.getByRole('button',{name:'筛选',exact:true}).click();const filter=page.getByRole('dialog');await filter.waitFor();assert.ok((await filter.boundingBox()).height<=height);await filter.getByRole('button',{name:'关闭',exact:true}).click();
  }
  if(width<1024){
   await page.getByRole('button',{name:locale==='it'?'Griglia a due colonne':'双列卡片',exact:true}).click();
   const columns=await page.locator('[data-product-sku]').evaluateAll(els=>els.slice(0,2).map(el=>el.getBoundingClientRect().x));assert.notEqual(columns[0],columns[1]);
   if(width===390){await page.reload({waitUntil:'domcontentloaded'});await page.locator('[data-product-sku]').first().waitFor();assert.equal(await page.getByRole('button',{name:'双列卡片',exact:true}).getAttribute('aria-pressed'),'true','view preference survives reload');}
   await page.screenshot({animations:"disabled",path:`${out}/grid-${width}-${locale}.png`});
   await page.getByRole('button',{name:locale==='it'?'Elenco compatto':'紧凑列表',exact:true}).click();
   await page.getByRole('button',{name:locale==='it'?'Seleziona':'选择',exact:true}).click();await page.getByRole('checkbox').filter({visible:true}).first().click();await page.locator('.admin-mobile-bulk-bar').waitFor();
   await page.screenshot({animations:"disabled",path:`${out}/selection-${width}-${locale}.png`});
   await page.getByRole('button',{name:locale==='it'?'Deseleziona':'取消选择',exact:true}).click().catch(async()=>{await page.getByRole('button',{name:locale==='it'?'Annulla':'取消',exact:true}).first().click();});
  }
  if(width===390){
   await page.getByRole('button',{name:'取消',exact:true}).first().click().catch(()=>{});
   await page.locator('[data-product-sku]').first().locator('button[aria-label$=": UX-1"]').click();await page.getByRole('menuitem',{name:'编辑商品',exact:true}).click();
   const productEditor=page.getByRole('dialog');await productEditor.waitFor();await productEditor.getByRole('group',{name:'商品名称',exact:true}).getByRole('textbox').fill('手机保存后返回列表');
   await productEditor.getByRole('button',{name:'保存',exact:true}).click();await productEditor.waitFor({state:'hidden'});assert.equal(productWrites.length,1);await page.locator('[data-product-sku]').first().getByText('手机保存后返回列表',{exact:true}).waitFor();
  }
  await page.getByRole('tab',{name:locale==='it'?'Catalogo':'目录',exact:true}).click();
  await page.getByRole('button',{name:locale==='it'?'Brand':'品牌',exact:true}).click();await page.locator('[data-catalog-node]').first().waitFor();
  const directory=await page.locator('[data-catalog-node]').evaluateAll(els=>els.map(el=>{const r=el.getBoundingClientRect();return{top:r.top,bottom:r.bottom,height:r.height}}));
  if(width===390){assert.ok(directory[0].top<=200,'directory starts in first 200px');assert.ok(directory.filter(r=>r.top>=0&&r.bottom<=700).length>=6,'6 full directory rows');}
  if(process.env.MOBILE_TEST_WIDTH)console.log('Directory types',await page.getByRole('group',{name:locale==='it'?'Tipo catalogo':'目录类型'}).locator('button').evaluateAll(els=>els.map(el=>({text:el.textContent,pressed:el.getAttribute('aria-pressed'),class:el.className,color:getComputedStyle(el).color}))));
  await page.screenshot({animations:"disabled",path:`${out}/directory-${width}-${locale}.png`});
  await page.locator('[data-catalog-node]').first().locator('button').first().click();const editor=width<768?page.getByRole('dialog'):page.locator('#catalog-node-editor');await editor.waitFor();
  const name=editor.locator('#catalog-node-nameZh');await name.fill('手机目录草稿');rejectSave=true;await editor.getByRole('button',{name:locale==='it'?'Salva':'保存目录',exact:true}).click();await editor.getByRole('alert').waitFor();assert.equal(await name.inputValue(),'手机目录草稿');
  await page.screenshot({animations:"disabled",path:`${out}/directory-editor-${width}-${locale}.png`});
  await editor.getByRole('button',{name:locale==='it'?'Salva':'保存目录',exact:true}).click();await page.waitForTimeout(200);assert.equal(posts.length,2);if(width<768)await page.getByRole('dialog').waitFor({state:'hidden'});
  if(width===390){
   await page.locator('[data-catalog-node]').first().locator('button').first().click();const unknownEditor=page.getByRole('dialog');await unknownEditor.locator('#catalog-node-nameZh').fill('结果未知后核对成功');unknownSave=true;
   await unknownEditor.getByRole('button',{name:'保存目录',exact:true}).click();await unknownEditor.getByRole('button',{name:'查询保存结果',exact:true}).waitFor();assert.equal(await unknownEditor.locator('#catalog-node-nameZh').isEnabled(),false);assert.equal(posts.length,3);
   await unknownEditor.getByRole('button',{name:'查询保存结果',exact:true}).click();await unknownEditor.waitFor({state:'hidden'});assert.equal(posts.length,3,'readback must not replay write');
  }
  assert.deepEqual(errors,[]);results.push({width,height,locale,productsVisible:metrics.rows.filter(r=>r.height>0&&r.top>=0&&r.bottom<=height).length,directoryTop:directory[0].top,directoryVisible:directory.filter(r=>r.height>0&&r.top>=0&&r.bottom<=height).length,viewSwitch:width<1024,editConflictPreservesDraft:true,saveReturnsToList:true,unknownReadback:width===390,overflow:false,pageErrors:0});
 }catch(e){console.log('FAIL',width,e.message,errors);await page.screenshot({animations:"disabled",path:`${out}/failure-${width}.png`,fullPage:true});throw e;}finally{await context.close();}
}
await fs.writeFile(out+(process.env.MOBILE_TEST_WIDTH?'/core-'+process.env.MOBILE_TEST_WIDTH+'-results.json':'/core-all-results.json'),JSON.stringify(results,null,2));console.log(JSON.stringify(results));await browser.close();
