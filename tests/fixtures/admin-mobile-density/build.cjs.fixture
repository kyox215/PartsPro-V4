const fs=require('fs'),path=require('path');const w=require('next/dist/compiled/webpack/webpack');const root=process.cwd(),dir=path.join(root,'.codex-tmp/mobile-density');
w.webpack({mode:'development',devtool:false,target:'web',entry:dir+'/entry.tsx',output:{path:dir,filename:'fixture.js',publicPath:'/fixture/'},resolve:{extensions:['.tsx','.ts','.mjs','.js'],alias:{'next/navigation$':dir+'/next-navigation.tsx','next/link$':dir+'/next-link.tsx','next/image$':dir+'/next-image.tsx','next/dynamic$':dir+'/next-dynamic.tsx','@/app/actions/i18n':dir+'/i18n-action.ts','@':root+'/src'}},module:{rules:[{test:/\.tsx?$/,exclude:/node_modules/,use:dir+'/tsx-loader.cjs'}]},plugins:[new w.webpack.DefinePlugin({'process.env':JSON.stringify({NODE_ENV:'development',NEXT_PUBLIC_SUPABASE_URL:'https://fixture.invalid',NEXT_PUBLIC_SUPABASE_ANON_KEY:'',NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:''}),'process.env.NODE_ENV':JSON.stringify('development'),'process.env.NEXT_PUBLIC_SUPABASE_URL':JSON.stringify('https://fixture.invalid')})]},(err,stats)=>{if(err||stats.hasErrors()){console.error(err||stats.toString({all:false,errors:true,moduleTrace:true,errorDetails:true}));process.exitCode=1}else console.log('Actual admin components compiled for local-only fixture');});
(async()=>{const postcss=require('postcss'),tailwind=require('@tailwindcss/postcss');const result=await postcss([tailwind({base:root})]).process(fs.readFileSync(root+'/src/app/globals.css','utf8'),{from:root+'/src/app/globals.css'});fs.writeFileSync(dir+'/style.css',result.css);console.log('Current production styles compiled');})().catch(error=>{console.error(error);process.exitCode=1;});
