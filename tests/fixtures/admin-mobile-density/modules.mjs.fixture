function fixture(url){const p=url.pathname;let data=[],kind='empty',special=null;const meta={source:'supabase',total:0,returned:0,syncedAt:date};
 if(p==='/api/me')return {json:{permissions,userId:uid(1),role:'admin',allowed:true},kind:'nonempty',label:'synthetic staff permissions'};
 if(p.includes('/notifications'))data={notifications:[],unreadCount:0};
 else if(p.includes('catalog-directory'))data={nodes:[{id:uid(900),kind:'department',value:'general_merchandise',nameZh:'电子产品',nameIt:'Elettronica',active:true,position:0,version:1,count:1}],revision:'1'};
 else if(p==='/api/admin/products')data=[product];
 else if(p==='/api/admin/products/model-groups')data=[];
 else if(p==='/api/admin/orders')data=orders;
 else if(p.startsWith('/api/admin/orders/'))data=orders.find(o=>p.endsWith(o.orderId)||p.endsWith(o.id))??orders[0];
 else if(p.includes('wallet-refunds'))data=[];
 else if(p==='/api/admin/rma'){data=rmas;Object.assign(meta,{queueCounts:{review:4,awaiting_return:0,receiving:0,qc:0,resolution:0,inventory_close:0,archive:0},countsComplete:true,totalIsExact:true,hasMore:false});}
 else if(p.startsWith('/api/admin/rma/'))data=rmas.find(r=>p.endsWith(r.id))??rmas[0];
 else if(p==='/api/admin/accounts')data=url.searchParams.get('accountType')==='employee'?[employee]:[account];
 else if(p.startsWith('/api/admin/accounts/'))data={account,customer,profileCustomer:customer,profileState:account.profileState,memberships:[],permissions:[],auditEvents:[]};
 else if(p==='/api/admin/permissions'||p==='/api/admin/permissions/catalog')data={permissions:permissions.map(id=>({id,label:id,group:id.split('.')[0],description:'Fixture permission'})),roleTemplates:[{id:'admin',label:'Fixture admin',description:'Synthetic all-permission role',permissions}],overrides:[]};
 else if(p==='/api/admin/finance/summary')data=financeSummary;
 else if(p==='/api/admin/finance/ledger')data=ledger;
 else if(p==='/api/admin/finance/cogs')data=allocations;
 else if(p.startsWith('/api/admin/finance/entries/'))data={id:p.split('/').at(-1),currency:'EUR',amountNet:40,vatAmount:8.8,amountGross:48.8,status:'paid',category:'other',description:'Fixture expense',occurredAt:'2026-10-10',notes:'',updatedAt:date};
 else if(p==='/api/admin/overview'){data={model};Object.assign(meta,{orderSource:'supabase',productSource:'supabase',orderTotal:6,ordersReturned:6,productTotal:1,productsReturned:1,errors:[]});}
 else if(p==='/api/admin/analytics')data={countries:[{country:'IT',pageviews:20,visitors:10}],daily:[{date:'2026-10-10',pageviews:20,visitors:10}],pages:[{route:'/catalogo',pageviews:20,visitors:10}],referrers:[{referrer:'direct',pageviews:20,visitors:10}],pageviews:20,visitors:10,range:Number(url.searchParams.get('range')||7),generatedAt:date};
 else if(p==='/api/admin/activity')data=[{id:uid(950),entity_type:'order',entity_id:orders[0].orderId,action:'order.accepted',result:'success',actor_role:'admin',created_at:date}];
 else if(p==='/api/admin/support/conversations'){data=[conversation];Object.assign(meta,{inboxCounts:{needsReply:1,unassigned:0,mine:1,all:1}});}
 else if(p.startsWith('/api/admin/support/conversations/'))data={conversation,messages:[{id:uid(501),body:long,createdAt:date,senderType:'customer',sender:{displayName:'Fixture buyer',userId:uid(21)}}],events:[]};
 else if(p==='/api/admin/ebay')data=ebay;
 else if(p==='/api/admin/remax/summary')data=remax;
 else if(p==='/api/admin/sold-stock-shortages'){data=[shortage];meta.summary={outOfStock:1,lowStock:0,totalSoldQty:7,suggestedRestockQty:10,total:1,windowDays:30,lowStockThreshold:10};}
 else if(p==='/api/admin/warehouse/replenishment'){data=[replenishment];meta.summary={active:1,ordered:0,supplierMissing:0,plannedQty:10};}
 else if(p==='/api/admin/inventory-health'){data=[health];meta.summary={stock_mismatch:0,reserved_mismatch:0,locked_orphan:0,active_zero_stock_sold:1,total:1};}
 else special='unhandled empty fallback';
 if(Array.isArray(data)){meta.total=data.length;meta.returned=data.length;kind=data.length?'nonempty':'empty';}else kind=Object.keys(data).length?'nonempty':'empty';
 return {json:{data,meta},kind,label:special??p};
}
const browser=await chromium.launch({channel:'chrome',headless:true});const results=process.argv[2]?previous.filter(r=>!process.argv[2].split(',').includes(r.panel)):[];
const panels=['orders','rma','accounts','finance','overview','remax','marketplace','support','timeline','analytics','settings','inventory'];
const selectedPanels=process.argv[2]?.split(',')??panels;
const cases=selectedPanels.flatMap(panel=>[320,390,1280].map(width=>({panel,width,locale:width===390?'it':'zh-CN'}))).concat(['orders','rma','accounts','finance','overview'].filter(panel=>selectedPanels.includes(panel)).map(panel=>({panel,width:390,locale:'zh-CN'}))).concat(selectedPanels.filter(panel=>['remax','finance','overview','analytics','support'].includes(panel)).map(panel=>({panel,width:768,locale:'it'})));
for(const c of cases){const context=await browser.newContext({viewport:{width:c.width,height:c.width<1024?760:900}});const page=await context.newPage();page.setDefaultTimeout(7000);const prior=previous.find(r=>r.panel===c.panel&&r.width===c.width&&r.locale===c.locale);const result={...c,fixtureStamp,previousIssues:[...new Set([...(prior?.previousIssues??[]),...(prior?.issues??[])])],previousWarnings:[...new Set([...(prior?.previousWarnings??[]),...(prior?.consoleWarnings??[])])],fixtures:[],pageErrors:[],consoleErrors:[],consoleWarnings:[],externalBlocked:[],checks:{},issues:[],screenshots:[]};
 page.on('pageerror',e=>result.pageErrors.push(e.message));page.on('console',m=>{if(m.type()==='error')result.consoleErrors.push(m.text());if(m.type()==='warning')result.consoleWarnings.push(m.text());});page.on('dialog',d=>d.accept());
 await context.route('**/*',async route=>{const req=route.request(),u=new URL(req.url());if(!['127.0.0.1','localhost'].includes(u.hostname)){result.externalBlocked.push(u.origin+u.pathname);return route.abort();}if(!u.pathname.startsWith('/api/'))return route.continue();if(!['GET','HEAD'].includes(req.method())){result.fixtures.push({path:u.pathname,method:req.method(),kind:'synthetic_rejected_write'});return route.fulfill({status:409,json:{error:{message:'Fixture rejected write; no live business request'}}});}const f=fixture(u);result.fixtures.push({path:u.pathname,method:req.method(),kind:f.kind,label:f.label});return route.fulfill({status:200,json:f.json});});
 try{const target=c.panel==='inventory'?'catalog&catalogView=sold-shortages':c.panel;await page.goto(`http://127.0.0.1:3178/admin?panel=${target}&locale=${c.locale}`,{waitUntil:'domcontentloaded'});await page.waitForTimeout(900);const main=page.locator('main');await main.waitFor();
 if(['finance','overview','analytics'].includes(c.panel)){
 const index=c.panel==='analytics'?0:1;
 const chart=page.locator('.admin-mobile-disclosure').filter({visible:true}).nth(index);await chart.waitFor();
 const before=await chart.evaluate(el=>({open:el.open,svgs:el.querySelectorAll('.recharts-surface').length}));result.checks.chartInitial=before;
 if(c.width<1024){if(before.open||before.svgs)result.issues.push('mobile collapsed chart mounted');await chart.locator('summary').click();await page.waitForTimeout(350);}
 await chart.locator('.recharts-surface').nth(c.panel==='overview'?1:0).waitFor({state:'visible',timeout:6000});
 const graph=await chart.locator('.recharts-surface').evaluateAll(els=>els.map(el=>({width:el.getBoundingClientRect().width,height:el.getBoundingClientRect().height})));result.checks.chartExpanded=graph;
 if(!graph.length||graph.some(g=>g.width<=0||g.height<=0))result.issues.push('expanded/desktop chart empty or zero size');
 await chart.locator('.recharts-surface').first().scrollIntoViewIfNeeded();await page.waitForTimeout(150);
 await page.screenshot({path:`${out}/module-chart-${c.panel}-${c.width}-${c.locale}.png`});result.screenshots.push(`module-chart-${c.panel}-${c.width}-${c.locale}.png`);
 if(c.width<1024){await chart.locator('summary').click();await page.waitForTimeout(250);result.checks.chartClosedUnmounted=await chart.locator('.recharts-surface').count()===0;if(!result.checks.chartClosedUnmounted)result.issues.push('closing chart did not unmount');}
 }
 if(c.panel==='finance'){await page.getByRole('tab',{name:c.locale==='it'?'Spese':'费用账本',exact:true}).click();await page.waitForTimeout(200);}
 if(c.panel==='remax'){const selection=page.locator('select:visible').first();await selection.selectOption({index:1});await page.waitForTimeout(200);result.checks.longSelectedBatch=await selection.inputValue();result.checks.arrivalQuantityVisible=await page.locator('[id^=remax-received-]').first().isVisible();if(!result.checks.arrivalQuantityVisible)result.issues.push('selected arrival batch lines hidden');await selection.scrollIntoViewIfNeeded();await page.screenshot({path:`${out}/module-remax-selected-${c.width}-${c.locale}.png`});result.screenshots.push(`module-remax-selected-${c.width}-${c.locale}.png`);}
 await main.evaluate(el=>el.scrollTo({top:0}));await page.waitForTimeout(250);
 const metrics=await page.evaluate(()=>{const visible=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0&&getComputedStyle(e).visibility!=='hidden';};const m=document.querySelector('main');const active=document.querySelector('[data-slot="tabs-content"][data-state="active"]');return{documentOverflow:document.documentElement.scrollWidth>innerWidth+1,mainOverflow:m.scrollWidth>m.clientWidth+1,visibleRows:[...document.querySelectorAll('.admin-mobile-row')].filter(visible).length,activeText:active?.textContent?.slice(0,300),desktopDisclosures:[...document.querySelectorAll('.admin-mobile-disclosure')].filter(visible).map(e=>({summaryVisible:visible(e.querySelector('summary')),contentVisible:[...e.children].filter(c=>c.tagName!=='SUMMARY').some(visible)})),outside:[...document.querySelectorAll('main *')].filter(visible).filter(e=>{const r=e.getBoundingClientRect();return r.x< -1||r.right>innerWidth+1}).slice(0,12).map(e=>({tag:e.tagName,text:e.textContent?.slice(0,50),class:e.className}))};});result.checks.layout=metrics;
 if(metrics.documentOverflow||metrics.mainOverflow)result.issues.push('page/main horizontal overflow');
 if(c.width>=1024&&metrics.desktopDisclosures.some(d=>d.summaryVisible||!d.contentVisible))result.issues.push('desktop disclosure visibility incorrect');
 if(['orders','rma','accounts','finance'].includes(c.panel)){result.checks.nonemptyRows=metrics.visibleRows>0||c.width>=1024&&await page.locator('tbody tr').count()>0;if(!result.checks.nonemptyRows)result.issues.push('nonempty core fixture rows not rendered');}
 if(c.width<1024&&['orders','rma','accounts','support'].includes(c.panel)){const row=page.locator('button.admin-mobile-row').filter({visible:true}).first();await row.click();const dialog=page.getByRole('dialog').filter({visible:true}).last();await dialog.waitFor();await page.waitForTimeout(180);result.checks.detailOpened=true;await page.screenshot({path:`${out}/module-detail-${c.panel}-${c.width}-${c.locale}.png`});result.screenshots.push(`module-detail-${c.panel}-${c.width}-${c.locale}.png`);await page.keyboard.press('Escape');await dialog.waitFor({state:'hidden'});result.checks.detailClosed=true;}
 if(c.width<1024&&c.panel==='finance'){await page.locator('.admin-mobile-row').filter({visible:true}).first().getByRole('button',{name:c.locale==='it'?'Correggi':'更正',exact:true}).click();const dialog=page.getByRole('dialog').last();await dialog.waitFor();await page.waitForTimeout(180);result.checks.editorOpened=true;await page.screenshot({path:`${out}/module-editor-finance-${c.width}-${c.locale}.png`});result.screenshots.push(`module-editor-finance-${c.width}-${c.locale}.png`);await page.keyboard.press('Escape');await dialog.waitFor({state:'hidden'});result.checks.editorClosed=true;}
 if(c.width<1024&&c.panel==='inventory'){const edit=page.getByRole('button',{name:c.locale==='it'?'Modifica':'编辑',exact:true}).filter({visible:true});if(await edit.count()){await edit.first().click();await page.getByRole('dialog').last().waitFor();result.checks.editorOpened=true;await page.keyboard.press('Escape');await page.getByRole('dialog').last().waitFor({state:'hidden'});result.checks.editorClosed=true;}}
 await page.waitForTimeout(300);await page.screenshot({path:`${out}/module-${c.panel}-${c.width}-${c.locale}.png`});result.screenshots.push(`module-${c.panel}-${c.width}-${c.locale}.png`);
 if(c.panel==='orders'&&c.width===390){const text=dictionaries.getAdminDictionary(c.locale==='it'?'it-IT':'zh-CN').admin;await page.getByRole('button',{name:text.topbar.mobileNavigationLabel,exact:true}).click();const sheet=page.getByRole('dialog');await sheet.getByRole('button',{name:text.nav.rma,exact:true}).click();await page.locator('button.admin-mobile-row').filter({visible:true}).first().waitFor();result.checks.moduleSwitch=true;}
 }catch(e){result.issues.push(e.message);await page.screenshot({path:`${out}/module-failure-${c.panel}-${c.width}-${c.locale}.png`,fullPage:true}).catch(()=>{});}
 if(result.pageErrors.length)result.issues.push('browser pageerror');if(result.consoleErrors.length)result.issues.push('console.error');if(result.consoleWarnings.some(w=>/width\(-1\)|height\(-1\)/.test(w)))result.issues.push('Recharts dimension warning');result.status=result.issues.length?'FAIL':'PASS';results.push(result);await fs.writeFile(`${out}/modules-results.json`,JSON.stringify(results,null,2));console.log(JSON.stringify({panel:c.panel,width:c.width,locale:c.locale,status:result.status,issues:result.issues,pageErrors:result.pageErrors}));await context.close();
}
await browser.close();const summary={executedCases:cases.length,cases:results.length,passed:results.filter(r=>r.status==='PASS').length,failed:results.filter(r=>r.status==='FAIL').length};console.log(JSON.stringify(summary));if(summary.failed)process.exitCode=1;
