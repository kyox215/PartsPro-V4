const http=require('http'),fs=require('fs'),path=require('path');const root=process.cwd(),dir=root+'/.codex-tmp/mobile-density';
http.createServer((req,res)=>{const url=new URL(req.url,'http://localhost');const name=url.pathname==='/sw.js'?root+'/public/sw.js':url.pathname.startsWith('/fixture/')?path.join(dir,path.basename(url.pathname)):url.pathname==='/style.css'?dir+'/style.css':url.pathname.startsWith('/pwa/')?path.join(root,'public/pwa',path.basename(url.pathname)):null;
if(name&&fs.existsSync(name)){res.setHeader('Content-Type',name.endsWith('.css')?'text/css':name.endsWith('.png')?'image/png':'application/javascript; charset=utf-8');res.end(fs.readFileSync(name));return;}if(url.pathname.startsWith('/api/')){res.writeHead(500);res.end('Fixture API must be intercepted');return;}
res.setHeader('Content-Type','text/html; charset=utf-8');res.end('<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="stylesheet" href="/style.css"></head><body style="margin:0"><div id="root"></div><script src="/fixture/fixture.js"></script></body></html>');}).listen(3178,'127.0.0.1',()=>console.log('Local-only component fixture :3178'));
