const fs=require('fs'),path=require('path');
const projectRequire=require('module').createRequire(process.cwd()+'/package.json');
const root=process.cwd(),dir=__HARNESS_DIR__;
fs.writeFileSync(dir+'/loader.cjs', `const ts=require(${JSON.stringify(projectRequire.resolve('typescript'))}); module.exports=function(source){return ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext,jsx:ts.JsxEmit.ReactJSX}}).outputText}`);
fs.writeFileSync(dir+'/navigation.ts', `const router={refresh(){window.refreshes=(window.refreshes||0)+1},push(){},replace(){}}; export const useRouter=()=>router; export const useSearchParams=()=>new URLSearchParams(); export const usePathname=()=>'/checkout';`);
fs.writeFileSync(dir+'/auth.ts', `const listeners=new Set();window.authEvent=(event,id)=>{for(const fn of listeners)fn(event,id?{user:{id}}:null)};export const createClient=()=>({auth:{onAuthStateChange(fn){listeners.add(fn);return{data:{subscription:{unsubscribe(){listeners.delete(fn)}}}}}}});`);
fs.writeFileSync(dir+'/env.ts', `export const isSupabaseConfigured=()=>true;`);
fs.writeFileSync(dir+'/sync.ts', `export const useCartSyncStatus=()=>({remoteStatus:'local',updatedAt:0});export const isCartRemoteSyncPending=()=>false;export const isCartRemoteSyncError=()=>false;export const requestCartSyncRetry=()=>{};`);
fs.writeFileSync(dir+'/header.tsx', `export const StoreHeader=()=>null;`);
fs.writeFileSync(dir+'/link.tsx', `import React from 'react';export default function Link({href,children,...props}){return <a href={href} {...props}>{children}</a>}`);
fs.writeFileSync(dir+'/image.tsx', `import React from 'react';export default function Image({src,alt}){return <img src={typeof src==='string'?src:src.src} alt={alt}/>} `);
const alias={'next/navigation':dir+'/navigation.ts','next/link':dir+'/link.tsx','next/image':dir+'/image.tsx',
 '@/lib/supabase/client':dir+'/auth.ts','@/lib/supabase/env':dir+'/env.ts',
 './cart-sync-bridge':dir+'/sync.ts','./store-header':dir+'/header.tsx','@':root+'/src'};
const webpack=projectRequire('next/dist/compiled/webpack/webpack').webpack;
webpack({mode:'development',devtool:false,entry:dir+'/entry.tsx',output:{path:dir,filename:'bundle.js'},resolve:{extensions:['.tsx','.ts','.mjs','.js'],alias,modules:[root+'/node_modules','node_modules']},module:{rules:[{test:/\.tsx?$/,exclude:/node_modules/,use:dir+'/loader.cjs'}]},plugins:[new webpack.DefinePlugin({'process.env.NODE_ENV':JSON.stringify('development')})]},(error,stats)=>{if(error||stats.hasErrors()){console.error(error||stats.toString({all:false,errors:true}));process.exitCode=1}else console.log('Harness compiled')});
