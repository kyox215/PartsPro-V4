import React from 'react';
import {createRoot} from 'react-dom/client';
import {AdminRmaPanel} from '@/components/partspro/admin-rma-panel';
import {I18nProvider} from '@/components/partspro/i18n-provider';
const locale=new URLSearchParams(location.search).get('locale') || 'zh-CN';
createRoot(document.getElementById('root')!).render(<I18nProvider locale={locale} scope="admin" dictionary={{}}><main className="mx-auto max-w-7xl p-3"><AdminRmaPanel/></main></I18nProvider>);
