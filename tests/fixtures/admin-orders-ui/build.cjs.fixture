const fs=require('fs'),path=require('path');
const root=process.cwd(),dir=__dirname;
const fromProject=require('module').createRequire(root+'/package.json');
fs.writeFileSync(dir+'/loader.cjs',`const ts=require(${JSON.stringify(fromProject.resolve('typescript'))});module.exports=function(source){return ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext,jsx:ts.JsxEmit.ReactJSX}}).outputText}`);
fs.writeFileSync(dir+'/navigation.ts',`export const useRouter=()=>({refresh(){},push(){},replace(){}});export const useSearchParams=()=>new URLSearchParams(location.search);export const usePathname=()=>'/admin';`);
fs.writeFileSync(dir+'/image.tsx',`import React from 'react';export default function Image({src,alt,fill,width,height,className,style,loading}){return <img src={typeof src==='string'?src:src?.src} alt={alt} width={fill?undefined:width} height={fill?undefined:height} loading={loading} className={className} style={fill?{position:'absolute',width:'100%',height:'100%',inset:0,...style}:style}/>}`);
const webpack=fromProject('next/dist/compiled/webpack/webpack').webpack;
webpack({mode:'development',devtool:false,entry:dir+'/entry.tsx',output:{path:dir,filename:'bundle.js'},resolve:{extensions:['.tsx','.ts','.mjs','.js'],alias:{'next/navigation':dir+'/navigation.ts','next/image':dir+'/image.tsx','./optimized-image':dir+'/image.tsx','@':root+'/src'},modules:[root+'/node_modules']},module:{rules:[{test:/\.css$/,type:"asset/source"},{test:/\.tsx?$/,exclude:/node_modules/,use:dir+'/loader.cjs'}]},plugins:[new webpack.DefinePlugin({'process.env.NODE_ENV':JSON.stringify('development'),'process.env.NEXT_PUBLIC_SUPABASE_URL':JSON.stringify(''),'process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY':JSON.stringify('')})]},(error,stats)=>{if(error||stats.hasErrors()){console.error(error||stats.toString({all:false,errors:true}));process.exitCode=1}else console.log('Actual admin order component compiled with isolated fixture APIs');});
