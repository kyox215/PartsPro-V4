const requireProject = require('module').createRequire(process.cwd() + '/package.json');
const { chromium } = requireProject(process.env.PLAYWRIGHT_MODULE || 'playwright');
const fs = require('fs'), http = require('http'), assert = require('assert/strict'), path = require('path');
const dir = __HARNESS_DIR__, output = process.env.RMA_UI_OUTPUT_DIR;
const id = '11111111-1111-4111-8111-111111111111', refundId = '22222222-2222-4222-8222-222222222222';
const base = { id, rmaNo: 'TEST-RMA-0001', orderId: 'TEST-ORDER', orderNumber: 'TEST-ORDER', sku: 'TEST-DISPLAY',
  productName: 'Motorola Moto G04 / Moto G24 Black', customerName: 'Test customer', status: 'received',
  quantity: 1, receivedQuantity: 1, receivedAt: '2026-10-04T10:00:00Z', createdAt: '04/10/2026',
  qcStatus: 'failed', inventoryDisposition: 'quarantine', requestedResolution: 'wallet_credit',
  refundPricingVerified: true, negotiationStatus: 'agreed', negotiationOutcome: 'refund_wallet',
  customerConfirmation: 'Test written agreement', attachments: [], events: [],
  refundPreview: { available: true, currency: 'EUR', maxRefundAmount: 13, quantity: 1, netAmount: 13, taxAmount: 0, shippingIncluded: false },
  replacementCandidates: [] };
let current = { ...base }, mode = 'operator', failRefund = false;
const actions = [], approvals = [], errors = [];
(async () => {
  fs.mkdirSync(output, { recursive: true });
  const { projectRmaV4Workflow } = await import(require('url').pathToFileURL(process.cwd() + '/src/lib/partspro-rma-v4-rules.mjs').href);
  const dto = () => {
    const caps = { manage: mode === 'operator', inventory: ['operator', 'warehouse'].includes(mode),
      refund: mode === 'operator', adjustStock: mode === 'operator', createReplacement: mode === 'operator' };
    return { ...current, ...projectRmaV4Workflow(current, caps),
      canApproveWalletRefund: ['operator', 'approver'].includes(mode) && current.walletRefundStatus === 'pending' && current.walletRequestedAmount > 0 };
  };
  const cssSource = fs.readFileSync(process.cwd() + '/src/app/globals.css', 'utf8')
    .replace('@import "tailwindcss";', '@import "tailwindcss" source(none);')
    + '\n@source "../components/partspro/admin-rma-panel.tsx";\n@source "../components/ui";';
  const css = (await requireProject('postcss')([requireProject('@tailwindcss/postcss')()])
    .process(cssSource, { from: process.cwd() + '/src/app/globals.css' })).css;
  const server = http.createServer((req, res) => {
    res.setHeader('Content-Type', req.url === '/bundle.js' ? 'application/javascript' : 'text/html');
    res.end(req.url === '/bundle.js' ? fs.readFileSync(dir + '/bundle.js')
      : '<!doctype html><html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
        + '<style>' + css + '</style><body><div id="root"></div><script>window.process={env:{NODE_ENV:"development"}}</script>'
        + '<script src="/bundle.js"></script></body></html>');
  });
  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', resolve); });
  let browser;
  try {
    browser = await chromium.launch({ headless: true, channel: 'chrome' });
    const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } }); page.setDefaultTimeout(10000);
    page.on('pageerror', error => errors.push(error.message));
    await page.route('**/api/**', async route => {
      const req = route.request(), pathname = new URL(req.url()).pathname;
      if (pathname === '/api/admin/wallet-refunds/' + refundId) {
        approvals.push(req.postDataJSON()); assert.equal(current.walletRefundStatus, 'pending');
        current = { ...current, status: 'refunded', walletRefundStatus: 'approved', walletCreditedAmount: 12.5, resolutionQuantity: 1 };
        return route.fulfill({ json: { data: { id: refundId, amount: 12.5, status: 'approved' } } });
      }
      if (pathname.endsWith('/actions')) {
        const data = req.postDataJSON(); actions.push(data); assert.ok(data.idempotencyKey.length >= 8);
        if (failRefund) { failRefund = false; return route.fulfill({ status: 503, json: { error: { message: 'Fixture temporary failure' } } }); }
        assert.equal(data.action, 'request_wallet_refund'); assert.equal(data.refundAmount, 13);
        current = { ...current, walletRefundRequestId: refundId, walletRefundStatus: 'pending', walletRequestedAmount: 13, resolutionAction: 'refund_wallet' };
        return route.fulfill({ json: { data: dto() } });
      }
      if (pathname === '/api/admin/rma') return route.fulfill({ json: { data: [dto()], meta: { total: 1, countsComplete: true } } });
      if (pathname === '/api/admin/rma/' + id) return route.fulfill({ json: { data: dto() } });
      return route.fulfill({ status: 500, json: { error: { message: 'Unexpected fixture API' } } });
    });
    const origin = 'http://127.0.0.1:' + server.address().port;
    const button = name => page.getByRole('button', { name, exact: true });
    const shot = async name => {
      assert.equal(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1), true, 'No horizontal overflow');
      await page.screenshot({ path: path.join(output, name + '.png'), fullPage: !name.endsWith('-confirm'), animations: 'disabled' });
    };
    await page.goto(origin); await button('申请钱包退款').click();
    const dialog = page.getByRole('dialog');
    const submit = dialog.getByRole('button', { name: '申请钱包退款', exact: true });
    assert.equal(await page.getByLabel('申请退款金额', { exact: true }).inputValue(), '');
    assert.equal(await submit.isDisabled(), true);
    for (const amount of ['13.01', '12.501']) {
      await page.getByLabel('申请退款金额', { exact: true }).fill(amount); assert.equal(await submit.isDisabled(), true);
    }
    await page.getByLabel('申请退款金额', { exact: true }).fill('13'); failRefund = true;
    await submit.click(); await page.getByText('Fixture temporary failure', { exact: true }).waitFor(); await submit.click();
    await dialog.waitFor({ state: 'hidden' }); await button('批准并入客户钱包').waitFor();
    assert.equal(actions.length, 2); assert.equal(actions[0].idempotencyKey, actions[1].idempotencyKey);
    assert.equal(approvals.length, 0); await shot('rma-desktop-pending');
    await button('批准并入客户钱包').click(); await page.getByRole('alertdialog').waitFor();
    await button('取消').click(); assert.equal(approvals.length, 0);
    await button('批准并入客户钱包').click(); await button('确认入钱包').click();
    await page.getByText(/12,50.*已入客户钱包/).waitFor(); assert.equal(approvals.length, 1);
    await shot('rma-desktop-credited');
    current = { ...base, walletRefundRequestId: refundId, walletRefundStatus: 'pending', walletRequestedAmount: 13, resolutionAction: 'refund_wallet' };
    mode = 'reader'; await page.goto(origin); await page.getByRole('heading', { name: base.productName, exact: true }).waitFor();
    assert.equal(await button('批准并入客户钱包').count(), 0); assert.equal(await button('申请钱包退款').count(), 0);
    mode = 'warehouse'; current = { ...base, qcStatus: 'pending', negotiationStatus: 'none' };
    await page.goto(origin); await button('记录质检').waitFor(); assert.equal(await button('申请钱包退款').count(), 0);
    current = { ...base, walletRefundRequestId: refundId, walletRefundStatus: 'pending', walletRequestedAmount: 13, resolutionAction: 'refund_wallet' };
    mode = 'approver'; await page.setViewportSize({ width: 390, height: 844 }); await page.goto(origin);
    await button('批准并入客户钱包').waitFor(); assert.equal(await button('申请钱包退款').count(), 0);
    await shot('rma-mobile-pending'); await button('批准并入客户钱包').click(); await page.getByRole('alertdialog').waitFor();
    const bounds = await page.getByRole('alertdialog').boundingBox();
    assert.ok(bounds.y >= 0 && bounds.y + bounds.height <= 845, 'Mobile confirmation stays within viewport');
    await shot('rma-mobile-confirm'); await button('取消').click();
    await page.goto(origin + '/?locale=it'); await button('Approva e accredita').waitFor(); await shot('rma-mobile-it');
    assert.equal(approvals.length, 1); assert.deepEqual(errors, []);
    const result = { passed: true, fixtureOnly: true, productionWrites: 0, scenarios: [
      'explicit cents and original cap', 'stable failed retry', 'pending vs actual credit', 'confirmation and cancellation',
      'reader/warehouse/approver separation', 'desktop/mobile/Italian'], pageErrors: errors };
    fs.writeFileSync(path.join(output, 'verification.json'), JSON.stringify(result, null, 2)); console.log(JSON.stringify(result));
  } finally { if (browser) await browser.close(); await new Promise(resolve => server.close(resolve)); }
})().catch(error => { console.error(error); process.exitCode = 1; });
